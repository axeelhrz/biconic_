    "start:tsx": "tsx -r ./register-paths.js src/main.ts",
    "worker:etl": "tsx src/workers/etl.worker.ts",
    "worker:excel": "tsx src/workers/excel.worker.ts",
    "worker:etl:prod": "node dist/workers/etl.worker",
    "worker:excel:prod": "node dist/workers/excel.worker"
  },
  "dependencies": {
