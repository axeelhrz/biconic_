# --- Backend propio (requerido) ---
USE_OWN_BACKEND=true
NEXT_PUBLIC_USE_OWN_BACKEND=true
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgres://biconic:biconic_dev_password@localhost:6432/biconic
JWT_SECRET=change-me-in-production-jwt-secret-32chars
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret
JWT_ACCESS_EXPIRES=8h
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=biconic
S3_SECRET_KEY=biconic_minio_password
S3_BUCKET=excel-uploads
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
ENCRYPTION_KEY=change-me-minimum-32-characters-long
MIGRATION_SECRET=
SUPABASE_DECOMMISSIONED=true

# Crons Vercel + callbacks internos workers ↔ Next
CRON_SECRET=
INTERNAL_ETL_SECRET=
INTERNAL_PROCESS_EXCEL_SECRET=
ETL_SCHEDULER_SECRET=

# Workers Railway (apuntan al front en Vercel)
# NEXT_INTERNAL_URL=https://tu-app.vercel.app

# Backend Railway: orígenes permitidos (Vercel + dominio propio)
# CORS_ORIGIN=https://tu-app.vercel.app

# URL pública del sitio (producción / encadenado process-excel)
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app
# PROCESS_EXCEL_CHUNK_MS=180000

# Admin local (scripts/seed-dev-admin.ts)
# DEV_ADMIN_EMAIL=admin@biconic.local
# DEV_ADMIN_PASSWORD=Admin123!
