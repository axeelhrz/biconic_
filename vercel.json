{
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/**/*.ts": { "maxDuration": 30 },
    "app/api/process-excel/route.ts": { "maxDuration": 800 },
    "app/api/etl/run/route.ts": { "maxDuration": 800 },
    "app/api/etl/run-preview/route.ts": { "maxDuration": 60 },
    "app/api/etl/[etl-id]/metrics-data/route.ts": { "maxDuration": 30 },
    "app/api/connection/join-query/route.ts": { "maxDuration": 300 },
    "app/api/connection/distinct-values/route.ts": { "maxDuration": 300 },
    "app/api/dashboard/aggregate-data/route.ts": { "maxDuration": 60 },
    "app/api/dashboard/raw-data/route.ts": { "maxDuration": 60 },
    "app/api/dashboard/distinct-values/route.ts": { "maxDuration": 45 },
    "app/api/dashboard/[dashboard-id]/etl-data/route.ts": { "maxDuration": 45 },
    "app/api/public/dashboard/[token]/aggregate-data/route.ts": { "maxDuration": 60 },
    "app/api/public/dashboard/[token]/raw-data/route.ts": { "maxDuration": 60 },
    "app/api/public/dashboard/[token]/distinct-values/route.ts": { "maxDuration": 45 },
    "app/api/public/dashboard/[token]/etl-data/route.ts": { "maxDuration": 45 },
    "app/api/viewer/dashboard/[dashboard-id]/etl-data/route.ts": { "maxDuration": 45 }
  },
  "crons": [
    {
      "path": "/api/etl/mark-stale-runs-failed",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/etl/run-scheduled",
      "schedule": "*/15 * * * *"
    }
  ]
}
